# Copia este archivo a .env y completa los valores.

# Base de datos SQLite usada por Prisma (ruta relativa a prisma/schema.prisma).
DATABASE_URL="file:./prisma/db/custom.db"

# Secreto para firmar los tokens de sesion (JWT). Obligatorio: el servidor no
# arranca sin el. Minimo 32 caracteres. Genera uno con:
#   openssl rand -base64 48
# Cambiarlo cierra todas las sesiones abiertas.
JWT_SECRET=""
