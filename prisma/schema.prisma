// INV-OTI — Prisma Schema
// Sistema de Inventario de Equipos Informáticos

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  usuario        String    @unique
  password       String
  nombre         String
  rol            String    @default("tecnico") // "admin" | "tecnico"
  estado         String    @default("activo") // "activo" | "inactivo"
  solicitudReset DateTime? // marca cuando el usuario pidio recuperar su contraseña
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Equipo {
  id                String   @id @default(cuid())
  tipo              String
  marca             String
  modelo            String
  sn                String   @unique
  codigoInterno     String?  @unique
  descripcion       String?
  estado            String   @default("activo") // activo, reparacion, baja, almacen, prestamo
  ubicacion         String?
  responsable       String?
  proveedor         String?
  factura           String?
  numeroContrato    String?
  costo             Float    @default(0) // en cordobas (NIO)
  fechaAdquisicion  String?
  fechaGarantia     String?
  vidaUtil          Int      @default(5)
  especificaciones  String?  // JSON string
  notas             String?
  foto              String?  // imagen en base64 (data URL)
  diagnosticoPdf    String?  // PDF de diagnostico (data URL), solo para equipos dados de baja
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  movimientos     Movimiento[]
  mantenimientos  Mantenimiento[]
}

model Movimiento {
  id          String   @id @default(cuid())
  equipoId    String
  tipo        String   // asignacion, transferencia, reparacion, retorno
  titulo      String
  fecha       String
  descripcion String?
  responsable String?
  createdAt   DateTime @default(now())

  equipo Equipo @relation(fields: [equipoId], references: [id], onDelete: Cascade)
}

model Mantenimiento {
  id              String   @id @default(cuid())
  equipoId        String
  tipo            String?  // Preventivo, Correctivo — nulo mientras es solo una solicitud del tecnico
  ubicacion       String?  // ubicacion del equipo al momento de programar el mantenimiento
  diagnostico     String?  // diagnostico previo que motiva el mantenimiento
  tecnicoDiagnostico String? // tecnico que realizo ese diagnostico
  descripcion     String?  // detalle del mantenimiento — lo completa el admin al programar
  fechaProgramada String?  // la completa el admin al programar
  fechaEjecucion  String?
  tecnico         String?  // tecnico asignado — lo completa el admin al programar
  estado          String   @default("Pendiente") // Solicitado, Pendiente, En proceso, Completado, Cancelado
  costo           Float    @default(0)
  createdAt       DateTime @default(now())

  equipo Equipo @relation(fields: [equipoId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
}
